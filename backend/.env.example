PORT=3001
FRONTEND_URL=http://localhost:3000
# Optional: public base URL of this API (used in HLS playlists). If unset,
# it is derived from the incoming request, which works behind most proxies.
API_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
WATERMARK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@secureshare.app
ADMIN_SECRET=
# Optional: leave REDIS_URL empty to use the built-in in-memory store
# (rate limiting + geo cache). Set it only if you run a Redis server.
REDIS_URL=
# Optional: leave empty/unset to skip virus scanning. Set only if you run
# a ClamAV daemon (clamd) somewhere.
CLAMAV_HOST=
CLAMAV_PORT=3310
# PDF page render scale (default 1.5). Higher = sharper but larger files.
PDF_RENDER_SCALE=1.5
